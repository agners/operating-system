#!/bin/sh

set -e

modprobe sht3x

if grep -q test=full-load /proc/cmdline; then
	stress-ng --cpu 4 -t 24h &
fi
if grep -q test=partial-load /proc/cmdline; then
	stress-ng --cpu 1 -t 24h &
fi
if grep -q test=load-io /proc/cmdline; then
	stress-ng --hdd 1 -t 24h &
fi


DATAFILE=temperature-$(date +%Y%m%d-%H%M%S).log

{
	echo -n "Uptime,LoadAvg,CPUFreq,Throttle,CPUTemp,"
	if [ -d /sys/class/nvme/nvme0/ ]; then
		echo -n "CaseTemp,"
	fi
	if [ -d /sys/bus/i2c/drivers/sht3x/1-0044/ ]; then
		echo -n "NVMeTemp,"
	fi
} > "${DATAFILE}"

while true; do
	{
		awk '{printf $1","}' /proc/uptime
		awk '{printf $1","}' /proc/loadavg
		awk '{printf $1","}' /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_cur_freq
		awk '{printf $1","}' /sys/devices/platform/soc/soc:firmware/get_throttled
		awk '{printf $1","}' /sys/devices/virtual/thermal/thermal_zone0/temp
		if [ -d /sys/bus/i2c/drivers/sht3x/1-0044/ ]; then
			awk '{printf $1","}' /sys/bus/i2c/drivers/sht3x/1-0044/hwmon/hwmon*/temp1_input
		fi
		if [ -d /sys/class/nvme/nvme0/ ]; then
			awk '{printf $1","}' /sys/class/nvme/nvme0/hwmon*/temp1_input
		fi
		echo ""
	} >> "${DATAFILE}"
	sleep 1
done
