{
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "commitMessageTopic": "{{depName}}",
  "git-submodules": {
    "enabled": true
  },
  "regexManagers": [
    // Upstream Linux kernel dependency update
    {
      "fileMatch": ["buildroot-external/configs/generic_aarch64_defconfig"],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE=\"(?<currentValue>.*?)\"",
      ],
      "depNameTemplate": "https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git",
      "datasourceTemplate": "git-tags",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
